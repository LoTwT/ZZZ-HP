DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zzz
PORT=3010

# 管理后台登录密码（明文仅放 .env；数据库存 bcrypt 哈希。改密后执行 node scripts/set-admin-password.mjs）
ADMIN_PASSWORD=

# 腾讯云 OCR（GeneralAccurateOCR）— 密钥只放服务端，勿提交 Git
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# 云识别每月上限；OCR_MONTH_USED_SEED 仅首次创建计数文件时生效（默认 4 → 剩余 996）
OCR_MONTHLY_LIMIT=1000
OCR_MONTH_USED_SEED=4
# 普通用户每人每月云识别次数；管理员不受此限，但仍受 OCR_MONTHLY_LIMIT 约束
# 站点管理员米游社 AID（逗号分隔），用于接收用户举报/解封申请通知；也可在账号管理中勾选「站点管理员」
SITE_ADMIN_MIHOYO_AIDS=

# 逗号分隔允许的前端 Origin；留空或 * 表示反射任意 Origin（仅建议本机开发）
# 生产示例：CORS_ORIGINS=https://zzz-hp.top,https://www.zzz-hp.top
CORS_ORIGINS=

# 全站 API 每分钟上限；登录相关另有更严限流
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=40

# 生产环境默认不在 500 响应中回传 err.message；需要排障时设为 1
# EXPOSE_ERROR_DETAIL=0
